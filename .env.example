# 复制为 .env 后只在本机填写。不要提交 .env，不要把密钥写进仓库。
# 默认关闭 live。未配置单价或必需的密钥时，进程保持 FIXTURE，不猜测价格。
# 密钥建议只在运行时通过进程环境注入，不要写进 .env。
# live 推荐：OOS_LLM_PROVIDER=openai，OOS_LLM_MODEL=gpt-6-luna，
# OOS_PRICE_IN_PER_MTOK=0.10，OOS_PRICE_OUT_PER_MTOK=0.50
# （来源 https://platform.openai.com/docs/pricing ，Standard，2026-11-03 核对；运行前请自行复核）。
# 其他 OpenAI 兼容提供方（DeepSeek、本地 vLLM/Ollama）的配置模板见 docs/MODEL_PROVIDERS.md；价格必须由操作者明确配置。
# 输入/输出单价分别填写 <INPUT_USD_PER_MILLION_TOKENS> / <OUTPUT_USD_PER_MILLION_TOKENS>。
# 本地模型也必须显式填写单价（确认免费可各填 0，空值不等于 0）。

OOS_LIVE_ENABLED=false
OOS_LIVE_BUDGET_USD=5.00
OOS_PRICE_IN_PER_MTOK=
OOS_PRICE_OUT_PER_MTOK=
OOS_LLM_API_KEY=
OOS_LLM_PROVIDER=
OOS_LLM_MODEL=
# openai 只允许下面的官方地址；openai_compatible 必须显式替换 base URL 并填写模型。
# 兼容远端必须 HTTPS 且配置运行时密钥；仅 localhost/127.0.0.1/::1 允许 HTTP 和无密钥。
OOS_LLM_BASE_URL=https://api.openai.com/v1
# 兼容 Chat 保守默认 json_object + schema 指令；确认支持 strict json_schema 才设 true。
OOS_LLM_JSON_SCHEMA_SUPPORTED=false
OOS_MODEL_REASONING_EFFORT=none

OOS_DATABASE_URL=sqlite:///./data/oos.db
# 长期本机试用可填专用绝对路径；留空仍使用临时目录。父目录须已存在。
# 程序创建末级目录为 0700、原件为 0600；已有目录须属当前用户且为 0700。
# 旧来源不自动搬迁，备份/清理由操作者负责，详见 docs/LOCAL_SOURCE_STORAGE.md。
OOS_SOURCE_STORAGE_DIR=
OOS_APPROVAL_TTL_SECONDS=600
OOS_WORKER_MAX_ACTIVE=2
OOS_MODEL_TIMEOUT_S=60
OOS_MODEL_MAX_TOKENS=1000
OOS_MODEL_MAX_CALLS_PER_TASK=3

# 已提交业务的只读核验：首次读回另计，随后最多 5 次自动重试。
OOS_VERIFICATION_MAX_RETRIES=5
OOS_VERIFICATION_BASE_DELAY_SECONDS=30
OOS_VERIFICATION_MAX_DELAY_SECONDS=3600
OOS_VERIFICATION_LEASE_SECONDS=120
OOS_VERIFICATION_BATCH_SIZE=100
# 可选 Langfuse 开关，默认关闭；本仓库不会发送任何数据。
OOS_TRACE_LANGFUSE=false
