# 复制为 .env 后只在本机填写。不要提交 .env，不要把密钥写进仓库。
# 默认关闭 live。未配置单价或密钥时，进程保持 FIXTURE，不猜测价格。

OOS_LIVE_ENABLED=false
OOS_LIVE_BUDGET_USD=5.00
OOS_PRICE_IN_PER_MTOK=
OOS_PRICE_OUT_PER_MTOK=
OOS_LLM_API_KEY=
OOS_LLM_PROVIDER=
OOS_LLM_MODEL=

OOS_DATABASE_URL=sqlite:///./data/oos.db
OOS_APPROVAL_TTL_SECONDS=600
OOS_WORKER_MAX_ACTIVE=2
OOS_MODEL_TIMEOUT_S=60
OOS_MODEL_MAX_TOKENS=1000
OOS_MODEL_MAX_CALLS_PER_TASK=3
